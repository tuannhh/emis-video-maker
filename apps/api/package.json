{
  "name": "@edu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@edu/shared": "workspace:*",
    "@edu/video": "workspace:*",
    "@google/genai": "^2.24.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@remotion/bundler": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "bullmq": "^6.3.9",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/pg": "^8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
