# Gemini qua Gemini Enterprise Agent Platform (service account, xem README)
GEMINI_PROVIDER=agent-platform
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Docker Compose: đường dẫn file khoá JSON trên máy (đặt NGOÀI thư mục mã nguồn), được gắn chỉ đọc vào container
GEMINI_KEY_FILE=
# Chạy trực tiếp trên máy (pnpm dev:*): trỏ thẳng tới file khoá
# GOOGLE_APPLICATION_CREDENTIALS=
# Gemini API key: với agent-platform là KEY PHỤ (không bắt buộc) cho dịch vụ Agent Platform chưa có (nhạc nền Lyria 3.5,
# model chưa mở trên Agent Platform); với developer-api (đường cũ, rollback) là key chính. Admin cũng nhập được trên trang Cài đặt.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Nano Banana 2 Lite (rẻ, tối đa 1K): hình minh hoạ
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Nano Banana 2 (2K, đẹp hơn): nhân vật, bối cảnh
GEMINI_IMAGE_HQ_MODEL=gemini-3.1-flash-image

# Chỉ dùng khi chạy api/worker trực tiếp trên máy (pnpm dev:*). Docker compose tự đặt các biến này.
DATABASE_URL=postgres://edu:edu@localhost:15432/edu
REDIS_URL=redis://localhost:16379
STORAGE_DIR=../../data/storage
FILES_PUBLIC_URL=
FILES_INTERNAL_URL=http://localhost:4100
API_PORT=4100
WEB_ORIGIN=http://localhost:3100
# Nhạc nền: lyria-3.5 qua API key phụ; không có key hoặc lỗi thì dùng model dự phòng trên Agent Platform
GEMINI_MUSIC_MODEL=
GEMINI_MUSIC_FALLBACK_MODEL=
# Giá USD / 1 triệu token để tự tính chi phí (xem README), để trống = chỉ đếm token
GEMINI_PRICING=

# Đăng nhập: bí mật ký phiên (>= 32 ký tự, ví dụ: openssl rand -base64 48) + admin tạo sẵn lần đầu
APP_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Chạy trên Cloud Run (xem docs/deploy-cloud-run.md); local giữ mặc định
# QUEUE_DRIVER=cloudrun
# GCP_PROJECT=
# GCP_REGION=
# WORKER_JOB=
# STORAGE_BUCKET=
# COOKIE_SECURE=true
