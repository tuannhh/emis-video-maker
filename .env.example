# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Chỉ dùng khi chạy api/worker trực tiếp trên máy (pnpm dev:*). Docker compose tự đặt các biến này.
DATABASE_URL=postgres://edu:edu@localhost:15432/edu
REDIS_URL=redis://localhost:16379
STORAGE_DIR=../../data/storage
FILES_PUBLIC_URL=
FILES_INTERNAL_URL=http://localhost:4100
API_PORT=4100
WEB_ORIGIN=http://localhost:3100
GEMINI_MUSIC_MODEL=lyria-3.5
# Giá USD / 1 triệu token để tự tính chi phí (xem README), để trống = chỉ đếm token
GEMINI_PRICING=
