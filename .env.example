# Gemini
# Không bắt buộc: admin nhập key trên trang Cài đặt (ưu tiên hơn biến này)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Chỉ dùng khi chạy api/worker trực tiếp trên máy (pnpm dev:*). Docker compose tự đặt các biến này.
DATABASE_URL=postgres://edu:edu@localhost:15432/edu
REDIS_URL=redis://localhost:16379
STORAGE_DIR=../../data/storage
FILES_PUBLIC_URL=
FILES_INTERNAL_URL=http://localhost:4100
API_PORT=4100
WEB_ORIGIN=http://localhost:3100
GEMINI_MUSIC_MODEL=lyria-3.5
# Giá USD / 1 triệu token để tự tính chi phí (xem README), để trống = chỉ đếm token
GEMINI_PRICING=

# Đăng nhập: bí mật ký phiên (>= 32 ký tự, ví dụ: openssl rand -base64 48) + admin tạo sẵn lần đầu
APP_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Chạy trên Cloud Run (xem docs/deploy-cloud-run.md); local giữ mặc định
# QUEUE_DRIVER=cloudrun
# GCP_PROJECT=
# GCP_REGION=
# WORKER_JOB=
# STORAGE_BUCKET=
# COOKIE_SECURE=true
