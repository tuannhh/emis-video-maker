{
  "name": "edu-video-ai",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter ./packages/shared --filter ./apps/api --filter ./apps/web run build",
    "build:shared": "pnpm --filter @edu/shared run build",
    "dev:api": "pnpm --filter @edu/api run dev",
    "dev:worker": "pnpm --filter @edu/api run dev:worker",
    "dev:web": "pnpm --filter @edu/web run dev",
    "dev:studio": "pnpm --filter @edu/video run studio",
    "typecheck": "pnpm -r run typecheck"
  }
}
